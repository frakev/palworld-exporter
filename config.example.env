# Configuration de palworld-exporter (format EnvironmentFile systemd).
# Chaque clé est surchargeable par une variable d'environnement de même nom.

# Adresse d'écoute HTTP de l'exporter (le /metrics que scrute Prometheus).
LISTEN=:9812

# API REST officielle du serveur Palworld. Activée par RESTAPIEnabled=True dans
# PalWorldSettings.ini ; elle écoute en boucle locale sur l'hôte de jeu. Aucun
# agent requis : l'exporter tourne sur la même machine et l'interroge en direct.
REST_URL=http://127.0.0.1:8212
REST_USER=admin
# = AdminPassword du serveur (PalWorldSettings.ini). Vide → métriques live du
# jeu désactivées (l'exporter n'émet alors que les stats de sauvegarde).
REST_PASSWORD=CHANGE_ME

# Parser de sauvegardes local (server.py), source des stats par joueur (Pals en
# boîte/équipe, niveau, captures, technologies…). Laisser vide pour ne pas
# émettre ces métriques. En écoute sur 127.0.0.1, pas de port à ouvrir.
PARSER_URL=http://127.0.0.1:8100

# Optionnel : si défini, /metrics exige "Authorization: Bearer <token>". Le
# port étant déjà restreint à l'IP maison par le pare-feu, c'est facultatif.
METRICS_TOKEN=
