# Configuration de palworld-parser (format EnvironmentFile systemd).
#
# Fichier réel : /etc/palworld-parser/parser.env
# Chargé par l'unit systemd (EnvironmentFile=). Chaque clé est aussi
# surchargeable par une variable d'environnement de même nom.
#
# install.sh écrit ce fichier au premier déploiement (et le conserve ensuite).
# Tu peux soit passer les options à install.sh, soit éditer ce fichier à la main
# puis « systemctl restart palworld-parser ».

# ── LE réglage important ──────────────────────────────────────────────────
# Dossier « SaveGames » de ton serveur : celui qui contient un sous-dossier de
# monde (identifiant hexadécimal) avec Level.sav + Players/. Le monde actif est
# détecté automatiquement — inutile de pointer sur le sous-dossier hexadécimal.
#
# Chemins courants selon l'installation :
#   steamcmd/Steam :  /home/steam/Steam/steamapps/common/PalServer/Pal/Saved/SaveGames
#   conteneur/pod  :  /palworld/Pal/Saved/SaveGames  (dépend de l'image)
#   Windows (WSL)  :  .../Pal/Saved/SaveGames
# Si SAVE_DIR contient directement Level.sav (bundle déjà extrait), ça marche aussi.
SAVE_DIR=/home/steam/Steam/steamapps/common/PalServer/Pal/Saved/SaveGames

# Base SQLite des snapshots (historique d'activité). Doit être inscriptible par
# l'utilisateur du service.
STATS_DB=/var/lib/palworld-parser/stats.db

# Port d'écoute local (127.0.0.1 uniquement, cf. server.py). L'exporter le lit
# via PARSER_URL=http://127.0.0.1:<PARSER_PORT>.
PARSER_PORT=8100

# Cadence de relecture des saves, en secondes. 0 = pas de reparse automatique
# (utile en sidecar cluster où l'app déclenche /reparse). Sur l'hôte de jeu :
# 300 (5 min) est un bon compromis — le parsing lit Level.sav en entier.
REPARSE_INTERVAL=300

# Nombre de snapshots d'historique conservés en base (graphes d'activité).
HISTORY_KEEP=2000
